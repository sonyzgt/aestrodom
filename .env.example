# ---------------------------------------------------------------
# PRISMATIC environment. Copy to .env and fill in. Never commit .env.
# Everything here is SERVER-ONLY unless prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------

# Database
DATABASE_URL=postgresql://prismatic:prismatic@localhost:5432/prismatic

# Claude (server only; never exposed to the browser or to generated apps)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Max output tokens per Claude turn
AI_MAX_OUTPUT_TOKENS=64000
# Max tool-loop iterations per request
AI_MAX_AGENT_STEPS=40
# Max automatic build-repair attempts
AI_MAX_REPAIR_ATTEMPTS=3

# Privy login (https://dashboard.privy.io). The App ID is public by design.
# Add your site origin (e.g. http://localhost:3000, https://prismatic.com) under Allowed origins.
# Optional: enable "Return user data in an identity token" so Prismatic can show the user's email/wallet.
NEXT_PUBLIC_PRIVY_APP_ID=cmujtdtmg00h70cl3ufh66vbp

# Auth.js (session cookies issued after Privy login is verified)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Domains
PRISMATIC_DOMAIN=prismatic.com
# Preview hosts become {slug}.{PRISMATIC_PREVIEW_DOMAIN}
PRISMATIC_PREVIEW_DOMAIN=preview.prismatic.com
# Shared secret Caddy uses when asking whether to issue a certificate
CADDY_ASK_SECRET=

# Plans / limits (FREE)
MAX_AI_REQUESTS_PER_DAY=20
MAX_PROJECTS_PER_USER=5
MAX_PROJECT_SIZE_MB=100
# Plans / limits (PRO)
PRO_MAX_AI_REQUESTS_PER_DAY=500
PRO_MAX_PROJECTS_PER_USER=50
PRO_MAX_PROJECT_SIZE_MB=5120
# Daily Claude token budget per user (input + output)
MAX_AI_TOKENS_PER_DAY=2000000
# Max length of a single prompt (characters)
MAX_PROMPT_CHARS=8000

# Deployment: "local" publishes containers on 127.0.0.1 ports,
# "production" routes {slug}.PRISMATIC_DOMAIN through Caddy on a private Docker network.
DEPLOYMENT_MODE=local
# Leave empty to use the local Docker socket / named pipe. Use a socket proxy in production.
DOCKER_HOST=
RUNTIME_IMAGE=prismatic-runtime:latest
PROJECT_NETWORK=prismatic_projects
CONTAINER_MEMORY_MB=512
CONTAINER_CPUS=1
CONTAINER_PIDS_LIMIT=256
BUILD_TIMEOUT_SECONDS=180

# Storage (project working copies + build artifacts). Defaults to ./storage
STORAGE_PATH=
STORAGE_DRIVER=local

# Rate limiting: in-memory when empty, Redis in production
REDIS_URL=

# Robinhood Chain
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Pons V2 (Robinhood Chain mainnet). Verify against https://docs.ponsfamily.com/docs/v2 before use.
PONS_V2_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_V2_LAUNCH_AND_BUY_ADDRESS=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948
PONS_V2_FEE_ESCROW_ADDRESS=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
PONS_V2_CHAIN_ID=4663

# Credits & API keys. Users top up in USD and pay the dollar value in $AESTRODOM at the live Pons curve price
# (ETH/USD from Coinbase + CoinGecko), with an ERC-20 transfer to the treasury that is verified on-chain.
CREDITS_TREASURY_ADDRESS=0x13d471c30f28081fac917a2112478548978eff86
CREDITS_TOKEN_ADDRESS=0x72c11afca4c6a30e01fadce6526cc35d857f4f20
# Credits per US dollar (0 turns top-ups off)
CREDITS_PER_USD=100
CREDIT_TOPUP_OPTIONS=1,5,10,25
CREDIT_TOPUP_MIN_USD=1
# Battleground voters must hold this much $AESTRODOM (USD at the live price) in their linked wallet; 0 = off.
VOTE_MIN_HOLD_USD=1

# Aestrodom Pass: 500 free-mint NFTs (contracts/AestrodomPass.sol). Each pass gives one free token
# launch per UTC day; the sponsor wallet pays the Pons launch fee + gas, and the creator fee
# recipient is the pass holder's wallet. Deploy with: node scripts/deploy-pass.mjs
# Defaults to the live contract (0xeaa60c3abe6259042ff099c4200cb2c1b0db46f0); set to override.
PASS_CONTRACT_ADDRESS=
# Dedicated hot wallet with a small ETH balance. Never reuse your main or treasury wallet.
SPONSOR_PRIVATE_KEY=
# Cost guard: at most this many sponsored launches per UTC day across all passes (500 = one per pass).
FREE_LAUNCH_DAILY_CAP=500
CREDIT_TOPUP_MAX_USD=500
# An AI run costs its real Claude cost plus CREDIT_MARGIN_PERCENT. Claude list prices in USD per million tokens
# for ANTHROPIC_MODEL (defaults are Claude Opus 5.5; cache write = 5-minute ephemeral). Update if the model changes.
CREDIT_MARGIN_PERCENT=5
CLAUDE_PRICE_INPUT=4
CLAUDE_PRICE_OUTPUT=20
CLAUDE_PRICE_CACHE_READ=0.2
CLAUDE_PRICE_CACHE_WRITE=5

# WalletConnect Cloud project id (public by design)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# IPFS uploads (token logos) via Pinata. Server-only; use a scoped JWT with file upload permission.
PINATA_JWT=
# Gateway used to show uploaded images (a dedicated Pinata gateway is faster)
PINATA_GATEWAY=https://gateway.pinata.cloud
TOKEN_LOGO_MAX_MB=2
